<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <config name="php_version" value="80000"/>

    <arg value="ps"/>
    <arg name="colors"/>
    <arg name="parallel" value="200"/>

    <file>./bin/</file>
    <file>./config/</file>
    <file>./src/</file>
    <file>./tests/</file>
    <file>./tests_legacy/</file>

    <rule ref="CakePHP2">
        <!-- The core keeps native types out of all signatures, tests included -->
        <exclude name="SlevomatCodingStandard.TypeHints"/>
    </rule>

    <!-- The core imports the classes that it names in annotations, as PHPStan resolves them in the namespace -->
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>

    <rule ref="Generic.PHP.DeprecatedFunctions.Deprecated">
        <!-- Using the deprecated libxml_disable_entity_loader functions. -->
        <exclude-pattern>src/Utility/Xml.php</exclude-pattern>
        <!-- Using the deprecated mcrypt_* functions. -->
        <exclude-pattern>src/Utility/Security.php</exclude-pattern>
        <!-- Using the deprecated strftime functions. -->
        <exclude-pattern>src/View/Helper/FormHelper.php</exclude-pattern>
        <exclude-pattern>src/Utility/CakeTime.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Utility/CakeTimeTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Utility/CakeTimeTest.php</exclude-pattern>
        <!-- Using the deprecated utf8_decode functions. -->
        <exclude-pattern>tests/TestCase/Utility/ValidationTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Utility/ValidationTest.php</exclude-pattern>
    </rule>

    <rule ref="CakePHP.Commenting.FunctionComment.Missing">
        <exclude-pattern>src/Error/MissingActionException.php</exclude-pattern>
        <exclude-pattern>src/Error/MissingControllerException.php</exclude-pattern>
        <exclude-pattern>src/Error/NotImplementedException.php</exclude-pattern>
        <exclude-pattern>src/Error/PrivateActionException.php</exclude-pattern>
        <exclude-pattern>src/TestSuite/Fixture/CakeFixtureInjector.php</exclude-pattern>
        <exclude-pattern>tests/test_app/*</exclude-pattern>
        <exclude-pattern>tests_legacy/test_app/*</exclude-pattern>
    </rule>

    <!-- Further underscored method names (CakePHP2 covers Controller/, Console/Command/ and Model/Behavior/) -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>tests/TestCase/Console/ShellTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Console/ShellTest.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Core/CakeObjectTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Core/CakeObjectTest.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/View/ViewTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/View/ViewTest.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/View/Helper/CacheHelperTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/View/Helper/CacheHelperTest.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Routing/DispatcherTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Routing/DispatcherTest.php</exclude-pattern>
    </rule>

    <!-- Allow @ error suppression in specific files where it's necessary -->
    <rule ref="Generic.PHP.NoSilencedErrors.Discouraged">
        <exclude-pattern>src/basics.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
        <exclude-pattern>src/Cache/Engine/FileEngine.php</exclude-pattern>
        <exclude-pattern>src/Console/Command/ConsoleShell.php</exclude-pattern>
        <exclude-pattern>src/Console/Shell.php</exclude-pattern>
        <exclude-pattern>src/Network/CakeResponse.php</exclude-pattern>
        <exclude-pattern>src/Utility/Folder.php</exclude-pattern>
        <exclude-pattern>src/View/Helper.php</exclude-pattern>
        <exclude-pattern>src/View/View.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Cache/CacheTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Cache/CacheTest.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Cache/Engine/MemcacheEngineTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Cache/Engine/MemcacheEngineTest.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Cache/Engine/MemcachedEngineTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Cache/Engine/MemcachedEngineTest.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Cache/Engine/RedisEngineTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Cache/Engine/RedisEngineTest.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Error/ErrorHandlerTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Error/ErrorHandlerTest.php</exclude-pattern>
    </rule>

    <!-- Allow eval() in ConsoleShell for interactive console functionality -->
    <rule ref="Squiz.PHP.Eval.Discouraged">
        <exclude-pattern>src/Console/Command/ConsoleShell.php</exclude-pattern>
    </rule>

    <!-- Allow public methods with underscore in test files -->
    <rule ref="CakePHP.NamingConventions.ValidFunctionName.PublicWithUnderscore">
        <exclude-pattern>tests/TestCase/Controller/ControllerTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Controller/ControllerTest.php</exclude-pattern>
    </rule>

    <!-- Allow unused variables in test files for testing purposes -->
    <rule ref="SlevomatCodingStandard.Variables.UnusedVariable.UnusedVariable">
        <exclude-pattern>src/TestSuite/Reporter/CakeHtmlReporter.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Error/ErrorHandlerTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Error/ErrorHandlerTest.php</exclude-pattern>
        <exclude-pattern>tests/TestCase/Utility/DebuggerTest.php</exclude-pattern>
        <exclude-pattern>tests_legacy/TestCase/Utility/DebuggerTest.php</exclude-pattern>
        <exclude-pattern>tests/test_app/Config/htmlhelper_tags.php</exclude-pattern>
        <exclude-pattern>tests_legacy/test_app/Config/htmlhelper_tags.php</exclude-pattern>
        <exclude-pattern>tests/test_app/Config/var_test.php</exclude-pattern>
        <exclude-pattern>tests_legacy/test_app/Config/var_test.php</exclude-pattern>
        <exclude-pattern>tests/test_app/Config/var_test2.php</exclude-pattern>
        <exclude-pattern>tests_legacy/test_app/Config/var_test2.php</exclude-pattern>
    </rule>

    <!-- tests_legacy/ is checked like tests/, for which the CakePHP and CakePHP2 standards exclude or include these sniffs -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="CakePHP.Commenting.FunctionComment">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="CakePHP.Commenting.TypeHint">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.FullyQualifiedClassNameInAnnotation">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.DNFTypeHintFormat">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>*/tests_legacy/*</exclude-pattern>
    </rule>
    <rule ref="CakePHP2.TypeHints.TestReturnTypeHint">
        <include-pattern>*/tests_legacy/TestCase/*</include-pattern>
    </rule>
</ruleset>
