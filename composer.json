{
    "name": "pieceofcake2/cakephp",
    "description": "The CakePHP 2 framework",
    "type": "library",
    "keywords": ["cakephp", "cakephp2", "framework"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "composer/ca-bundle": "^1.5",
        "php81_bc/strftime": "^0.7.5",
        "symfony/polyfill-intl-icu": "^1.29",
        "symfony/polyfill-mbstring": "^1.29"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.3",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1",
        "rector/rector": "^2.1"
    },
    "replace": {
        "cakephp/cakephp": "^2.0"
    },
    "suggest": {
        "ext-mbstring": "For better performance with multibyte string operations, install the native mbstring extension instead of using the polyfill",
        "ext-openssl": "You need to install ext-openssl or ext-mcrypt to use AES-256 encryption",
        "ext-mcrypt": "You need to install ext-openssl or ext-mcrypt to use AES-256 encryption",
        "ext-intl": "Required to use IntlDateFormatter instead of strftime, if not Symfony polyfill will be used."
    },
    "autoload": {
        "psr-4": {
            "Cake\\": "src/"
        },
        "files": ["src/LegacyClassLoader.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Cake\\Test\\Fixture\\": "tests/Fixture/",
            "Cake\\Test\\TestCase\\": "tests/TestCase/",
            "TestApp\\": "tests/test_app/src/"
        },
        "classmap": ["tests/test_app/"],
        "exclude-from-classmap": [
            "vendor/pieceofcake2/app/src/Controller/AppController.php",
            "vendor/pieceofcake2/app/src/Controller/PagesController.php",
            "vendor/pieceofcake2/app/src/Console/Command/AppShell.php",
            "vendor/pieceofcake2/app/src/Model/AppModel.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "bin": [
        "bin/cake"
    ]
}
